# =============================================================================
# falcon-portfolio environment template
# Copy to .env.local and fill in values. Never commit real secrets.
# =============================================================================

# --- Deploy stage (admin/nav behavior) ---
# local | qa | staging | preview | production
SITE_ENV=local

# --- CMS provider ---
# mock = content/mock/*.json (offline)
# sanity = live Sanity project/dataset below
CMS_PROVIDER=mock
# Amplify SSR: also set NEXT_PUBLIC_CMS_PROVIDER=sanity so builds pick it up reliably.
# NEXT_PUBLIC_CMS_PROVIDER=sanity

# --- Sanity ---
# Datasets: development (local / GH Pages preview) | production (AWS)
# GitHub Pages also supports ?dataset=production|development at runtime.
SANITY_PROJECT_ID=
SANITY_DATASET=development
# Baked into client for Pages URL dataset switching / Amplify SSR:
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=development
SANITY_API_VERSION=2024-01-01
SANITY_USE_CDN=true
# Read token (required if the dataset is private)
# SANITY_API_READ_TOKEN=

# Write token — local scripts only (seed, upload, migrate). Never expose to the browser.
# SANITY_API_WRITE_TOKEN=

# --- Sanity Studio ---
# SANITY_DEV_PORT=3333
# Hosted Studio URL for QA/production admin nav (/admin redirect)
# SANITY_STUDIO_URL=
# ADMIN_NAV_URL=

# --- Typical local Sanity setup ---
# SITE_ENV=local
# CMS_PROVIDER=sanity
# SANITY_PROJECT_ID=your-project-id
# SANITY_DATASET=development
# SANITY_API_WRITE_TOKEN=

# --- Contact form ---
# Prefer Web3Forms for GitHub Pages (static export — no /api/contact).
# Free key: https://web3forms.com
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
#
# Resend only works with a Node server (next start / AWS), not static Pages:
# RESEND_API_KEY=
# CONTACT_FORM_TO_EMAIL=you@example.com
# CONTACT_FORM_FROM_EMAIL=
