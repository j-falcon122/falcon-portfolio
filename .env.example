# =============================================================================
# falcon-portfolio environment template
# Copy to .env.local and fill in values. Never commit real secrets.
# =============================================================================

# --- Deploy stage (admin/nav behavior) ---
# local | qa | staging | preview | production
SITE_ENV=local

# --- CMS provider ---
# mock = content/mock/*.json (offline)
# sanity = live Sanity project/dataset below
CMS_PROVIDER=mock

# --- Sanity (free plan: one active dataset) ---
# Create dataset `development` in Sanity Manage (keep the default `production`
# dataset empty as your second free slot, or delete it if unused).
SANITY_PROJECT_ID=
SANITY_DATASET=development
SANITY_API_VERSION=2024-01-01
SANITY_USE_CDN=true
# Read token (required if the dataset is private)
# SANITY_API_READ_TOKEN=

# Write token — local scripts only (seed, upload, migrate). Never expose to the browser.
# SANITY_API_WRITE_TOKEN=

# --- Sanity Studio ---
# SANITY_DEV_PORT=3333
# Hosted Studio URL for QA/production admin nav (/admin redirect)
# SANITY_STUDIO_URL=
# ADMIN_NAV_URL=

# --- Typical local Sanity setup ---
# SITE_ENV=local
# CMS_PROVIDER=sanity
# SANITY_PROJECT_ID=your-project-id
# SANITY_DATASET=development
# SANITY_API_WRITE_TOKEN=

# --- Contact form (optional) ---
# RESEND_API_KEY=
# CONTACT_FORM_TO_EMAIL=you@example.com
# CONTACT_FORM_FROM_EMAIL=
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
